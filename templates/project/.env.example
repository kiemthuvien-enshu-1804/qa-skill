# Mẫu biến môi trường. init của plugin web-qa copy file này thành .env.local — điền giá trị thật vào .env.local.
# KHÔNG điền key thật vào file này (file mẫu được copy/commit cùng kit).
# Scripts tự đọc .env.local; Claude bị chặn đọc nó (xem .claude/settings.json).

# API key CMS — tên biến phải khớp ${...} trong qa-config.json → cms.headers
CMS_API_KEY=

# API key microCMS có quyền ghi (POST/PUT/PATCH/DELETE) — chỉ cho service DEV, dùng bởi qa-cms-seed.
# Nếu CMS_API_KEY đã có quyền ghi thì có thể đặt cms.seed.headers trỏ về ${CMS_API_KEY}.
CMS_WRITE_API_KEY=

# Tiền tố dữ liệu test, viết tắt tên người test (vd KIM → [KIM001]). Mỗi tester 1 tiền tố.
QA_SEED_PREFIX=

# Figma personal access token (Figma → Settings → Security → Personal access tokens; quyền file_content:read, file_comments:read)
# Không có thì qa-figma-spec dùng Figma MCP.
FIGMA_TOKEN=

# Basic Auth của site test (nếu có)
QA_BASIC_USER=
QA_BASIC_PASS=

# Tên người test ghi vào checklist
QA_TESTER=

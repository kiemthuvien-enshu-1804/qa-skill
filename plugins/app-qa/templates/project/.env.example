# Bí mật RIÊNG của thư mục QA này. Copy thành .env.local (init tự làm). Không commit.
# Key TestRail/Backlog cá nhân KHÔNG để ở đây — để ở ~/.app-qa/.env (dùng chung mọi dự án).
# Chỉ điền TESTRAIL_*/BACKLOG_* ở đây khi dự án này dùng TestRail/Backlog khác (ghi đè file chung).
# Project ID / key nằm trong qa-config.json (testrail.projectId, backlog.projectKey).

# Tài khoản test (tên biến khai báo ở qa-config.json accounts) — theo dữ liệu seed của DB local/test
QA_ADMIN_A_USER=
QA_ADMIN_A_PASS=

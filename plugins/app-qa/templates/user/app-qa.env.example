# Key cá nhân cho plugin app-qa — dùng chung cho MỌI thư mục QA webapp trên máy này.
# Vị trí: C:\Users\<bạn>\.app-qa\.env   (đổi chỗ bằng biến APPQA_ENV_FILE)
# Không commit, không gửi cho người khác: mọi kết quả/bug/comment ghi bằng key này đứng tên bạn.
# Dự án dùng TestRail/Backlog khác → ghi đè trong .env.local của thư mục QA đó.

# TestRail — My Settings → API Keys
TESTRAIL_URL=
TESTRAIL_USER=
TESTRAIL_KEY=

# Backlog — Cá nhân → Cài đặt → API (chỉ cần URL space, vd https://etgrp.backlog.com)
BACKLOG_URL=
BACKLOG_API_KEY=
